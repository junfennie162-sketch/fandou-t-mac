# LUT-SA SystemAbility —— 以「vendor/ohemu/lutsa」组件形态并入 OpenHarmony 标准系统
#
# 产物：
#   /system/lib64/libtmac_sa.z.so    （SA 进程宿主库：sa_main 按 profile 加载）
#   /system/bin/lut_sa_client        （客户端：经 samgr 跨 IPC 调用 6901，用于自证可用）
#   /system/profile/lut_sa.json      （SA 注册表：SA_ID=6901 → libtmac_sa.z.so）
#   /system/etc/init/lut_sa.cfg      （init 启动项：exec /system/bin/sa_main /system/profile/lut_sa.json）
#   /system/etc/lut_sa/kcfg.ini      （t-mac 查表内核的形状参数表：引擎在 guest 里运行时读）
#   /system/etc/init/lut_evidence.cfg + /system/bin/lut_evidence.sh
#                                    （开机一次性取证：把 SA 调用结果打到串口 ttyS0）
#
# 引擎形态（STA-3 定论）：**用 OH 树自己的 clang 编成静态库**（intree/build_engine.sh），
#   GN 只负责把它链进 SA。两条实测教训：
#   ① 仓库里那对预编译 libllama.a/libggml.a 是 DevEco SDK 工具链编的，引用 std::__n1::*，
#      而 OH 源码树的 libc++ 用 std::__h::* —— ABI 命名空间不同，link 必然一堆 undefined。
#   ② OH 标准系统的 GN 工具链对 C++ 强制 -fno-exceptions，而 llama.cpp 用 throw 报错；
#      GN 模板又不暴露 configs（`configs += [...]` 报 "Undefined identifier"）→ 在 GN 里编不了。
#   → 引擎（llama+ggml+t-mac 内核+engine_shim）在 GN 之外用同一套 OH clang 编成 .a，
#     ABI 与 OH libc++ 一致；对 GN 而言就是一个普通 prebuilt 静态库。
import("//build/ohos.gni")

ohos_shared_library("lut_sa") {
  sources = [
    "src/lut_sa_ability.cpp",        # SystemAbility 绑定（OnStart→Publish / OnSvcCmd dump）
    "src/lut_sa.cpp",                # 业务内核：会话 / 加载 / 暖机 / 真推理（走引擎 C 接口）
    "src/session_workspace.cpp",
    "src/tile_compute.cpp",
    "src/tile_pool.cpp",
    "src/qos_policy.cpp",
    "src/lut_kernel_ref.cpp",        # 便携参考内核：现在只作「算法自检锚点」（入口已改名 ref_*）
    "idl/lut_sa_proxy.cpp",          # ILutSa 生成物（IPC 代理）
    "idl/lut_sa_stub.cpp",           # ILutSa 生成物（IPC 桩）
  ]
  include_dirs = [ "include", "idl" ]

  # S6-1：ability_manager 的内检头必须**显式加 include_dirs** —— 它的
  # config("ability_manager_public_config") 带 visibility 限制（只给自己和几个测试路径），
  # 所以 external_deps 只提供链接、不传 include 路径。下面这些路径是照抄它自己的 public_config：
  include_dirs += [
    "//foundation/ability/ability_runtime/interfaces/inner_api/ability_manager/include",
    "//foundation/ability/ability_runtime/interfaces/inner_api/app_manager/include/appmgr",
    "//foundation/ability/ability_runtime/interfaces/inner_api/dataobs_manager/include",
    "//foundation/ability/ability_runtime/interfaces/kits/native/ability/native",
    "//foundation/ability/ability_runtime/interfaces/kits/native/ability/ability_runtime",
    "//foundation/ability/ability_runtime/interfaces/kits/native/appkit/ability_runtime/context",
    "//foundation/ability/ability_runtime/interfaces/kits/native/appkit/app",
    "//foundation/ability/ability_runtime/interfaces/kits/native/appkit",
    "//foundation/ability/ability_runtime/interfaces/kits/native/appkit/dfr",
    "//foundation/ability/ability_runtime/interfaces/kits/native/ability/native/continuation/kits",
    "//foundation/ability/ability_runtime/interfaces/kits/native/ability/native/continuation/distributed",
  ]

  # 引擎静态库 + t-mac 调优内核（kernels.cc 编在同一份 .a 里，所以业务层不再单独编一份，
  # 避免同名符号重复）。业务层通过 include/t-mac/kernels.h 的 inline 分派器调用 LUT 内核。
  lib_dirs = [ "prebuilt" ]
  libs = [ "llama_engine" ]

  # FIX-41: lut_sa_ability.h/.cpp 整体被 #ifdef TMAC_SA_SAMGR_BINDING 包着；
  # 不定义这个宏，SA 绑定（REGISTER_SYSTEM_ABILITY_BY_ID / OnStart→Publish）就整段不参与编译，
  # 结果 .so 能加载但 samgr 里没有 6901，hidumper 也看不到。原来漏了这个 defines。
  defines = [ "TMAC_SA_SAMGR_BINDING" ]

  external_deps = [
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "ipc:ipc_core",
    "c_utils:utils",
    "hilog:libhilog",
    "ability_base:want",   # S6-1b 路线A：只要 Want 类型（先量它会不会拉 arkcompiler）
    # S6-1 的 AMS 直链**暂时去掉**：实测它的依赖闭包会把 arkcompiler 整个拖进来（FIX-64），
    # 换路径（Raw IPC 直调 AMS / 执行放到应用侧）后再按需加回，避免 SA 无谓地背上 JS 运行时
  ]

  # FIX-38: output_name 写 "libtmac_sa.z" 会被 OH 再补一层变成 libtmac_sa.z.z.so，
  # 与 sa_profile 里写的 libtmac_sa.z.so 对不上 → SA 永远加载不到。这里只写基名。
  output_name = "libtmac_sa"
  install_enable = true
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

# 客户端：另一个进程经 samgr 拿到 6901 并逐项调用 ILutSa（IPC 可用性的硬证据）
ohos_executable("lut_sa_client") {
  sources = [
    "src/lut_sa_client.cpp",
    "idl/lut_sa_proxy.cpp",          # 客户端侧只需要 proxy（不需要 stub）
  ]
  include_dirs = [ "include", "idl" ]
  external_deps = [
    "samgr:samgr_proxy",
    "ipc:ipc_core",
    "c_utils:utils",
    "hilog:libhilog",
  ]
  output_name = "lut_sa_client"
  install_enable = true
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

# S7-1a：无障碍「读屏」能力探针（**独立工具，不进 SA**）
#
# 依赖闭包的纪律（FIX-64 那条教训的第二次应用）：
#   external_deps 里**不能**写 "accessibility:accessibleability" —— 它的 BUILD.gn 明确声明了
#   "runtime_core:ani" + "napi:ace_napi"，等于把 JS 运行时整包拖进构建闭包。
#   改为两条腿各走各的：
#     · 编译期：显式 include_dirs（下面那串路径照抄各组件自己的 config/public_config）
#     · 链接期：镜像里**现成**的 libaccessibleability.z.so（prebuilt 拷贝，与 llama_engine 同一手法）
#   它自带的 DT_NEEDED（libani / libace_napi / libffrt / libmmi-client …）镜像里本来就有，
#   且该 .so 已装在 /system/lib64（实测确认），所以运行时不需要新增任何东西。
#
# 为什么探针单独存在：写 SA 的 ReadScreen 之前，先独立回答「无障碍能不能拿到元素树」。
#   已知硬约束（读码所得，本轮实测验证）：客户端必须被系统 Init(channel, channelId) 才会
#   isConnected_ —— 也就是**读屏者在系统眼里必须是一个无障碍 ability**。
ohos_executable("lut_a11y_dump") {
  sources = [ "src/lut_a11y_dump.cpp" ]
  # 下面这份 include 列表**抄自无障碍库自己的编译命令行**（从 ninja 的
  # obj/foundation/barrierfree/accessibility/.../accessible_ability_client_impl.o 那条边里掏出），
  # 顺序也照抄 —— 顺序有意义：同名头（hilog_wrapper.h / event_handler.h / ani.h 各有好几份）
  # 必须由无障碍自己那份先命中，否则会撞到别的组件的同名实现。
  include_dirs = [
    "//foundation/barrierfree/accessibility/interfaces/innerkits/aafwk/include",
    "//foundation/barrierfree/accessibility/interfaces/innerkits/common/include",
    "//foundation/barrierfree/accessibility/common/interface/include",
    "//foundation/barrierfree/accessibility/common/log/include",
    "//foundation/barrierfree/accessibility/frameworks/aafwk/include",
    "$root_gen_dir/foundation/barrierfree/accessibility/common/interface",
    "//arkcompiler/runtime_core/static_core/plugins/ets/runtime/ani",   # 客户端头 include <ani.h>
    "//arkcompiler/runtime_core/static_core/plugins",
    "//foundation/arkui/napi/interfaces/kits",                          # 还 include napi/native_api.h
    "//foundation/arkui/napi/interfaces/inner_api",
    "//foundation/arkui/napi",
    "//third_party/node/src",                                           # node_api.h 在这里
    "//third_party/libuv/include",
    "//base/notification/eventhandler/interfaces/inner_api",
    "//base/notification/eventhandler/frameworks/eventhandler/include",
    "//base/hiviewdfx/hilog/interfaces/native/innerkits/include",
    "//base/startup/init/interfaces/innerkits/include",
    "//third_party/bounds_checking_function/include",
    "//commonlibrary/c_utils/base/include",
    "//commonlibrary/c_utils/base/src",
    "//foundation/communication/ipc/interfaces/innerkits/ipc_core/include",
    "//foundation/systemabilitymgr/samgr/interfaces/innerkits/samgr_proxy/include",
    "//foundation/resourceschedule/ffrt/include",
    "//foundation/resourceschedule/ffrt/interfaces/kits",
    "//foundation/resourceschedule/ffrt/interfaces/inner_api",
    "//foundation/multimodalinput/input/interfaces/native/innerkits",
    "//foundation/multimodalinput/input/interfaces/native/innerkits/event/include",
    "//foundation/multimodalinput/input/interfaces/native/innerkits/proxy/include",
    "//base/hiviewdfx/hitrace/interfaces/native/innerkits/include/hitrace_meter",
    "//base/hiviewdfx/hitrace/utils",
  ]
  # 抄自 accessibility 的 accessibleability_private_config（日志域不定义就编不过）
  defines = [
    "AAMS_LOG_TAG = \"lut_a11y\"",
    "AAMS_LOG_DOMAIN = 0xD001D01",
  ]
  lib_dirs = [ "prebuilt" ]
  # 两份都要：客户端类在 accessibleability，元素结构体的实现（GetContent/IsClickable…）在 accessibility_common
  libs = [
    "accessibleability.z",
    "accessibility_common.z",
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]
  output_name = "lut_a11y_dump"
  install_enable = true
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

# FIX-38/39: SA 注册表必须走官方 ohos_sa_profile 模板才会进 /system/profile/；
# 用 ohos_prebuilt_etc + relative_install_dir="profile" 会落到 /system/etc/profile/。
# 注意该模板在 part_name 已给定时不读 subsystem_name，多写会 GN 报 "Assignment had no effect"。
ohos_sa_profile("lut_sa_profile") {
  sources = [ "sa_profile/lut_sa.json" ]
  part_name = "lutsa"
}

# FIX-38: relative_install_dir 是相对 /system/etc（不是 /system），写 "etc/init" 会变成
# /system/etc/etc/init/，init 根本读不到。正确写 "init"。
ohos_prebuilt_etc("lut_sa_init_cfg") {
  source = "etc/init/lut_sa.cfg"
  relative_install_dir = "init"
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

# t-mac 形状参数表：引擎（ggml_tmac）在 guest 里用 TMAC_KCFG_FILE 指到这里读
ohos_prebuilt_etc("lut_sa_kcfg") {
  source = "etc/lut_sa/kcfg.ini"
  relative_install_dir = "lut_sa"
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

# 开机取证：本环境 hidumper 自身不可用（exit=3）、hdc 的 hdcd 被 watchdog 杀，
# 所以用「一次性服务把结果打到串口 ttyS0」作为取证通道，脚本与 cfg 一起装机。
ohos_prebuilt_etc("lut_evidence_cfg") {
  source = "etc/init/lut_evidence.cfg"
  relative_install_dir = "init"
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

ohos_prebuilt_etc("lut_evidence_sh") {
  source = "evidence/lut_evidence.sh"
  relative_install_dir = "bin"
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

# FIX-71：取证拆成两个一次性服务 —— 一个服务扛完所有分段会被 watchdog 掐（服务有时间预算），
# 重的（模型加载/生成/鲁棒性）单独一个服务、单独一份预算
ohos_prebuilt_etc("lut_evidence2_cfg") {
  source = "etc/init/lut_evidence2.cfg"
  relative_install_dir = "init"
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

ohos_prebuilt_etc("lut_evidence2_sh") {
  source = "evidence/lut_evidence2.sh"
  relative_install_dir = "bin"
  install_images = [ "system" ]
  part_name = "lutsa"
  subsystem_name = "ohemu"
}

group("lut_sa_package") {
  deps = [
    ":lut_sa",
    ":lut_sa_client",
    ":lut_a11y_dump",
    ":lut_sa_profile",
    ":lut_sa_init_cfg",
    ":lut_sa_kcfg",
    ":lut_evidence_cfg",
    ":lut_evidence_sh",
    ":lut_evidence2_cfg",
    ":lut_evidence2_sh",
  ]
}
