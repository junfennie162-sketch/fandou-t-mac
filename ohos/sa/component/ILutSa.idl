interface OHOS.LutSa.ILutSa {
  String NativeVersion();
  void LoadModel([in] String path, [in] int threads, [in] int nCtx);
  String Generate([in] String prompt, [in] int nPredict, [in] double temp, [in] int topK);
  String GetMetrics();
  String SelfTest();
  String Release();
  String ExecuteAction([in] String action, [in] String arg);
  String ExecuteIntent([in] String utterance);
  // S7-1b：感知方向（读屏，无障碍元素树）—— 与执行方向独立；maxNodes<=0 用默认上限
  String ReadScreen([in] int maxNodes);
}