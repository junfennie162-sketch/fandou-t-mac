{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
        // 【试验】HarmonyOS 把 AppServiceExtensionAbility 判为 privilege extension，第三方应用声明它会被 BMS 拒装
        // （模拟器日志：not allow use privilege extension）——先注释掉验证能否装上
//
//     "extensionAbilities": [
//       {
//         // 引擎的「系统服务化」形态：独立进程（process）+ 可被别的应用连接（exported）
//         "name": "LutEngineExtension",
//         "srcEntry": "./ets/engineext/LutEngineExtension.ets",
//         "description": "$string:module_desc",
//         "type": "service",
//         "exported": true,
//         // 独立进程示例（本 SDK 的 schema 对 service 类型不允许 process/isolationProcess 字段，
//         // 两个分支的字段交集里只有 extensionProcessMode 可用；取值 instance = 每实例独立进程）
//         "extensionProcessMode": "instance"
//       }
//     ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:startIcon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
