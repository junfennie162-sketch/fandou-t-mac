index 5b45155b..0fff364f 100644
--- a/ggml/src/ggml-cpu-impl.h
+++ b/ggml/src/ggml-cpu-impl.h
@@ -424,6 +424,15 @@ static inline ggml_fp16_t ggml_compute_fp32_to_fp16(float f) {
 #if defined(__AVX__) || defined(__AVX2__) || defined(__AVX512F__) || defined(__SSSE3__) || defined(__SSE3__) || defined(__SSE__)
 #if !defined(__riscv)
 #include <immintrin.h>
+
+// OHOS emulator fix: the HarmonyOS virtual CPU reports AVX2 without FMA.
+// Route the FMA intrinsics through mul+add so ggml's AVX2 paths stay usable.
+#if defined(__AVX2__) && !defined(__FMA__)
+#define _mm256_fmadd_ps(a, b, c)  _mm256_add_ps(_mm256_mul_ps((a), (b)), (c))
+#define _mm256_fnmadd_ps(a, b, c) _mm256_sub_ps((c), _mm256_mul_ps((a), (b)))
+#define _mm_fmadd_ps(a, b, c)     _mm_add_ps(_mm_mul_ps((a), (b)), (c))
+#define _mm_fnmadd_ps(a, b, c)    _mm_sub_ps((c), _mm_mul_ps((a), (b)))
+#endif
 #endif
 #endif
 #endif
