diff --git a/ggml/include/ggml-tmac.h b/ggml/include/ggml-tmac.h
index f79b6744..1f9acc30 100644
--- a/ggml/include/ggml-tmac.h
+++ b/ggml/include/ggml-tmac.h
@@ -7,7 +7,10 @@
 #include <arm_neon.h>
 typedef float16_t tmac_float_type;
 #else
-typedef float tmac_float_type;
+// OHOS x86 fix: T-MAC kernels store fp16 (half = _Float16) even on x86; the old
+// `float` alias made sizeof() != 2, which skipped the fp32->fp16 activation
+// conversion in ggml.c and fed fp32 data to fp16 kernels (garbage output).
+typedef _Float16 tmac_float_type;
 #endif
 
 #ifdef  __cplusplus
